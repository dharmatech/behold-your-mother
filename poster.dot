// The New Adam & the New Eve — a typology poster.
//
// Layout: one row per parallel.
//   left   = Old Covenant type
//   center = the parallel that links them
//   right  = New Covenant fulfillment
//
// Render with ./render.sh  (writes poster.svg and poster.png)

digraph poster {
  graph [
    newrank=true
    rankdir=TB
    bgcolor="#FBF7EF"
    fontname="P052"
    pad="1.5,1.2"
    nodesep=0.9
    ranksep=0.6
    splines=line
  ]

  node [
    shape=box
    style="rounded,filled"
    fontname="P052"
    fontsize=19
    penwidth=3
    margin="0.3,0.2"
  ]

  // ── Title, column headers, footer ────────────────────────────

  subgraph frame {
    node [shape=plaintext style="" margin=0 group=par]

    title [label=<<TABLE BORDER="0" CELLSPACING="10">
      <TR><TD><FONT POINT-SIZE="96" COLOR="#3B2A16"><B>THE NEW ADAM &amp; THE NEW EVE</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="32" COLOR="#6B5236"><I>how the first man and woman, the throne of David, and the Ark of the Covenant foreshadow Christ and his Mother</I></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="24" COLOR="#6B5236">“The New Testament lies hidden in the Old, and the Old is unveiled in the New.”  — St. Augustine (CCC 129)</FONT></TD></TR>
    </TABLE>>]

    hdr_ot  [group=ot label=<<TABLE BORDER="0"><TR><TD><FONT POINT-SIZE="36" COLOR="#8A6440"><B>OLD COVENANT</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="24" COLOR="#8A6440"><I>the type</I></FONT></TD></TR></TABLE>>]
    hdr_par [label=<<TABLE BORDER="0"><TR><TD><FONT POINT-SIZE="36" COLOR="#9A7A22"><B>THE PARALLEL</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="24" COLOR="#9A7A22"><I>what links them</I></FONT></TD></TR></TABLE>>]
    hdr_nt  [group=nt label=<<TABLE BORDER="0"><TR><TD><FONT POINT-SIZE="36" COLOR="#2F5A8A"><B>NEW COVENANT</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="24" COLOR="#2F5A8A"><I>the fulfillment</I></FONT></TD></TR></TABLE>>]

    footer [label=<<TABLE BORDER="0" CELLSPACING="6">
      <TR><TD><FONT POINT-SIZE="18" COLOR="#6B5236">Scripture quotations follow the RSV.  CCC = Catechism of the Catholic Church.  LXX = Septuagint, the Greek Old Testament.</FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="18" COLOR="#6B5236">St. Justin Martyr, <I>Dialogue with Trypho</I> 100  ·  St. Irenaeus, <I>Against Heresies</I> III.22.4</FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="18" COLOR="#6B5236">Pius XII, <I>Munificentissimus Deus</I> (1950) and <I>Ad Caeli Reginam</I> (1954)</FONT></TD></TR>
    </TABLE>>]
  }

  // ── Old Covenant column ──────────────────────────────────────

  subgraph old_covenant {
    node [group=ot width=6.8 fillcolor="#F1E5CF" color="#8A6440" fontcolor="#3E2C1A"]

    adam [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>ADAM</B></FONT></TD></TR>
      <TR><TD>the first man, formed<BR/>from the dust of the ground</TD></TR>
      <TR><TD><I>“by one man's disobedience<BR/>many were made sinners”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Gen 2:7  ·  Rom 5:12, 19</FONT></TD></TR>
    </TABLE>>]

    eve [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>EVE</B></FONT></TD></TR>
      <TR><TD>the first woman,<BR/>formed from Adam's side</TD></TR>
      <TR><TD><I>a virgin, she listened<BR/>to the serpent and disobeyed</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Gen 2:21–22; 3:1–6</FONT></TD></TR>
    </TABLE>>]

    fall [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>THE FIRST SIN</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#8A6440"><I>in the garden of Eden</I></FONT></TD></TR>
      <TR><TD>Eve takes the fruit and eats;<BR/>“she also gave some to her husband …<BR/>and he ate”</TD></TR>
      <TR><TD><I>their eyes are opened:<BR/>shame, exile from the garden, death</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Gen 3:6–7, 19, 23</FONT></TD></TR>
    </TABLE>>]

    woman_ot [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>“WOMAN”</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#8A6440">אִשָּׁה<I>   ’ishshah</I></FONT></TD></TR>
      <TR><TD>“she shall be called Woman,<BR/>because she was taken out of Man”</TD></TR>
      <TR><TD>through the whole story of the Fall<BR/>she is simply “the woman” —<BR/>only afterward is she named Eve</TD></TR>
      <TR><TD><I>“I will put enmity between you<BR/>and the woman, and between<BR/>your seed and her seed”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Gen 2:23; 3:1–16, 20</FONT></TD></TR>
    </TABLE>>]

    solomon [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>SOLOMON</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#8A6440"><I>son of David, king of Israel</I></FONT></TD></TR>
      <TR><TD>seated on the throne of David</TD></TR>
      <TR><TD><I>God's promise to David's son:<BR/>“I will establish the throne<BR/>of his kingdom for ever”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">2 Sam 7:12–16  ·  1 Kgs 2:12</FONT></TD></TR>
    </TABLE>>]

    bathsheba [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>BATHSHEBA</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#8A6440"><I>mother of King Solomon</I></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#8A6440">גְּבִירָה<I>   gebirah, “great lady”</I></FONT></TD></TR>
      <TR><TD>in the house of David the queen<BR/>was the king's mother, not his wife:<BR/>Solomon had 700 wives, but one mother</TD></TR>
      <TR><TD><I>the king rises to meet her, bows,<BR/>and sets a throne for her at his right hand;<BR/>she brings petitions to the king</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">1 Kgs 2:19–20; 11:3; 15:13  ·  Jer 13:18</FONT></TD></TR>
    </TABLE>>]

    ark [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>THE ARK</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#8A6440"><I>of the covenant, in the Holy of Holies</I></FONT></TD></TR>
      <TR><TD>a chest overlaid with gold;<BR/>above it, between the cherubim,<BR/>God met with his people</TD></TR>
      <TR><TD><I>“There I will meet with you”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Ex 25:10–22  ·  1 Kgs 8:6–11</FONT></TD></TR>
    </TABLE>>]

    ark_held [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>WHAT THE ARK HELD</B></FONT></TD></TR>
      <TR><TD><B>the tablets of the Law</B><BR/>the word of God, written in stone</TD></TR>
      <TR><TD><B>a golden jar of manna</B><BR/>bread from heaven in the wilderness</TD></TR>
      <TR><TD><B>Aaron's rod that budded</B><BR/>sign of the true priesthood</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Heb 9:4  ·  Deut 10:5  ·  Ex 16:33–34  ·  Num 17:8–10</FONT></TD></TR>
    </TABLE>>]

    glory_cloud [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>THE GLORY CLOUD</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#8A6440"><I>over the tabernacle</I></FONT></TD></TR>
      <TR><TD><I>“the cloud covered the tent of meeting,<BR/>and the glory of the LORD<BR/>filled the tabernacle”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#8A6440">ἐπεσκίαζεν<I>   epeskiazen, “overshadowed”</I></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Ex 40:34–35 (LXX)</FONT></TD></TR>
    </TABLE>>]

    ark_holy [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>A HOLY VESSEL</B></FONT></TD></TR>
      <TR><TD>made of acacia, “wood that does not decay”<BR/>in the Greek, overlaid with pure gold<BR/>within and without</TD></TR>
      <TR><TD>so holy that Uzzah,<BR/>touching it, was struck dead</TD></TR>
      <TR><TD><I>“Arise, O LORD, and go to thy resting place,<BR/>thou and the ark of thy might”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Ex 25:10–11 (LXX)  ·  2 Sam 6:6–7  ·  Ps 132:8</FONT></TD></TR>
    </TABLE>>]

    lost_ark [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>THE LOST ARK</B></FONT></TD></TR>
      <TR><TD>before the Babylonian exile,<BR/>Jeremiah hid the ark in a cave</TD></TR>
      <TR><TD><I>“The place shall be unknown<BR/>until God gathers his people<BR/>together again”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">2 Macc 2:4–8</FONT></TD></TR>
    </TABLE>>]

    david_sets_out [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>DAVID SETS OUT</B></FONT></TD></TR>
      <TR><TD><I>“David arose and went …<BR/>to bring up from there the ark of God”</I></TD></TR>
      <TR><TD>from Baale-judah, in Judah</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">2 Sam 6:2  ·  1 Chr 13:6</FONT></TD></TR>
    </TABLE>>]

    david_asks [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>DAVID ASKS</B></FONT></TD></TR>
      <TR><TD>afraid of the LORD after Uzzah's death</TD></TR>
      <TR><TD><I>“How can the ark of the LORD<BR/>come to me?”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">2 Sam 6:9</FONT></TD></TR>
    </TABLE>>]

    david_dances [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>DAVID DANCES</B></FONT></TD></TR>
      <TR><TD><I>“David danced before the LORD<BR/>with all his might”</I></TD></TR>
      <TR><TD>“leaping and dancing before the LORD,”<BR/>while the Levites raise their voices<BR/>with music before the ark</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">2 Sam 6:14–16  ·  1 Chr 15:28; 16:4–5</FONT></TD></TR>
    </TABLE>>]

    obed_edom [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>THREE MONTHS</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#8A6440"><I>in the house of Obed-edom</I></FONT></TD></TR>
      <TR><TD><I>“the ark of the LORD remained<BR/>in the house of Obed-edom … three months;<BR/>and the LORD blessed Obed-edom<BR/>and all his household”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">2 Sam 6:10–12</FONT></TD></TR>
    </TABLE>>]
  }

  // ── The parallels (center column) ────────────────────────────

  subgraph parallels {
    node [group=par width=6.6 fillcolor="#F5E6B0" color="#B08A2E" fontcolor="#3B2F12" peripheries=1]

    new_adam [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>THE NEW ADAM</B></FONT></TD></TR>
      <TR><TD>Adam “was a type<BR/>of the one who was to come”</TD></TR>
      <TR><TD><I>“The first man Adam became a living being;<BR/>the last Adam became a life-giving spirit.”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Rom 5:14  ·  1 Cor 15:22, 45  ·  CCC 411, 504</FONT></TD></TR>
    </TABLE>>]

    new_eve [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>THE NEW EVE</B></FONT></TD></TR>
      <TR><TD><I>“the knot of Eve's disobedience<BR/>was loosed by the obedience of Mary”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="17">— St. Irenaeus, c. 180</FONT></TD></TR>
      <TR><TD><I>“Death through Eve, life through Mary.”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="17">— the Fathers</FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">St. Justin, <I>Dialogue</I> 100  ·  CCC 411, 494, 726</FONT></TD></TR>
    </TABLE>>]

    urging [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>AT HER URGING</B></FONT></TD></TR>
      <TR><TD>In Eden, at Eve's urging,<BR/>Adam commits the <B>first sin</B>.</TD></TR>
      <TR><TD>At Cana, at Mary's urging,<BR/>Jesus performs his <B>first sign</B>.</TD></TR>
      <TR><TD><I>Eve led her husband away from God's word;<BR/>Mary points to it: “Do whatever he tells you.”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Gen 3:6  ·  Jn 2:3–5, 11  ·  CCC 1613, 2618</FONT></TD></TR>
    </TABLE>>]

    woman [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>WOMAN</B></FONT></TD></TR>
      <TR><TD>Jesus calls his mother not “Mother”<BR/>but “Woman” — the name of Eve<BR/>before the Fall</TD></TR>
      <TR><TD><I>Mary is the Woman of the first Gospel,<BR/>at enmity with the serpent (Gen 3:15)</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">CCC 410–411, 726</FONT></TD></TR>
    </TABLE>>]

    king [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>THE KING</B></FONT></TD></TR>
      <TR><TD>the promise to David's son<BR/>is fulfilled in the everlasting<BR/>reign of Christ</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Mt 1:1  ·  Lk 1:32–33  ·  CCC 439</FONT></TD></TR>
    </TABLE>>]

    queen_mother [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>THE QUEEN MOTHER</B></FONT></TD></TR>
      <TR><TD>the Son of David reigns for ever,<BR/>and the queen of his kingdom<BR/>is his mother</TD></TR>
      <TR><TD><I>as Bathsheba brought petitions to Solomon,<BR/>Mary brings our needs to her Son</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Jn 2:3  ·  CCC 966, 969  ·  <I>Ad Caeli Reginam</I></FONT></TD></TR>
    </TABLE>>]

    new_ark [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>THE NEW ARK</B></FONT></TD></TR>
      <TR><TD>the ark held God's presence<BR/>among his people; for nine months<BR/>God himself dwelt within Mary</TD></TR>
      <TR><TD><I>Mary is “the ark of the covenant,<BR/>the place where the glory of the Lord dwells”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">CCC 2676  ·  Litany of Loreto: “Ark of the Covenant”</FONT></TD></TR>
    </TABLE>>]

    she_carried [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>WHAT SHE CARRIED</B></FONT></TD></TR>
      <TR><TD>the ark carried signs;<BR/>Mary carried the One they signified</TD></TR>
      <TR><TD><I>the Law  →  the Word<BR/>the manna  →  the Bread of Life<BR/>the priestly rod  →  the High Priest</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Heb 9:4</FONT></TD></TR>
    </TABLE>>]

    overshadowed [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>OVERSHADOWED</B></FONT></TD></TR>
      <TR><TD>the same Greek verb describes<BR/>the glory cloud over the tabernacle<BR/>and the Spirit over Mary</TD></TR>
      <TR><TD><I>where God's glory rests,<BR/>there God dwells</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Ex 40:35 (LXX)  ·  Lk 1:35  ·  CCC 697</FONT></TD></TR>
    </TABLE>>]

    incorruptible [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>INCORRUPTIBLE</B></FONT></TD></TR>
      <TR><TD>Pius XII: the ark of incorruptible wood<BR/>is “a type of the most pure body<BR/>of the Virgin Mary,” preserved<BR/>from the corruption of the tomb</TD></TR>
      <TR><TD><FONT POINT-SIZE="16"><I>Munificentissimus Deus</I> 26  ·  Ps 132:8</FONT></TD></TR>
    </TABLE>>]

    ark_revealed [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>THE ARK REVEALED</B></FONT></TD></TR>
      <TR><TD>John sees the lost ark in heaven,<BR/>and the very next thing he sees<BR/>is the Woman</TD></TR>
      <TR><TD><I>the chapter break between them<BR/>was added only in the 13th century</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Rev 11:19 – 12:1</FONT></TD></TR>
    </TABLE>>]

    arose [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>AROSE AND WENT</B></FONT></TD></TR>
      <TR><TD>the same words open both journeys,<BR/>and both go into Judah</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">2 Sam 6:2  ·  Lk 1:39</FONT></TD></TR>
    </TABLE>>]

    come_to_me [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>“COME TO ME?”</B></FONT></TD></TR>
      <TR><TD>David asks how the ark could come to him;<BR/>Elizabeth asks the same of Mary</TD></TR>
      <TR><TD><I>“Mary's visitation to Elizabeth thus became<BR/>a visit from God to his people”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">2 Sam 6:9  ·  Lk 1:43  ·  CCC 717</FONT></TD></TR>
    </TABLE>>]

    leaping [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>LEAPING FOR JOY</B></FONT></TD></TR>
      <TR><TD>David leaps before the ark;<BR/>John leaps before the One<BR/>whom Mary carries</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">2 Sam 6:16  ·  Lk 1:41, 44</FONT></TD></TR>
    </TABLE>>]

    house_blessed [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="38"><B>A HOUSE BLESSED</B></FONT></TD></TR>
      <TR><TD>the ark stays three months<BR/>and blesses the house that receives it;<BR/>so does Mary</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">2 Sam 6:11  ·  Lk 1:41–42, 56</FONT></TD></TR>
    </TABLE>>]
  }

  // ── New Covenant column ──────────────────────────────────────

  subgraph new_covenant {
    node [group=nt width=6.8 fillcolor="#E4ECF6" color="#2F5A8A" fontcolor="#1C2E45"]

    jesus [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>JESUS CHRIST</B></FONT></TD></TR>
      <TR><TD>the last Adam, the man from heaven,<BR/>who begins the new creation</TD></TR>
      <TR><TD><I>“by one man's obedience<BR/>many will be made righteous”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Rom 5:19  ·  1 Cor 15:47</FONT></TD></TR>
    </TABLE>>]

    mary [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>MARY</B></FONT></TD></TR>
      <TR><TD>a virgin, she listened<BR/>to the angel and obeyed</TD></TR>
      <TR><TD><I>“let it be to me<BR/>according to your word”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Lk 1:26–38</FONT></TD></TR>
    </TABLE>>]

    cana [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>THE FIRST SIGN</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A"><I>the wedding at Cana</I></FONT></TD></TR>
      <TR><TD>at the wedding feast Mary tells him,<BR/>“They have no wine,” and tells the servants,<BR/>“Do whatever he tells you”</TD></TR>
      <TR><TD><I>water becomes wine, “the first of his signs”:<BR/>he “manifested his glory;<BR/>and his disciples believed in him”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Jn 2:1–11</FONT></TD></TR>
    </TABLE>>]

    woman_nt [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>“WOMAN”</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A">γύναι<I>   gynai</I></FONT></TD></TR>
      <TR><TD>at Cana:<BR/>“Woman, … my hour has not yet come”</TD></TR>
      <TR><TD>at the Cross, when the hour has come:<BR/>“Woman, behold, your son!”</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Jn 2:4; 19:26</FONT></TD></TR>
    </TABLE>>]

    christ_king [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>CHRIST THE KING</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A"><I>Jesus, Son of David</I></FONT></TD></TR>
      <TR><TD><I>“the Lord God will give to him<BR/>the throne of his father David …<BR/>and of his kingdom there will be no end”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Lk 1:32–33</FONT></TD></TR>
    </TABLE>>]

    mary_queen [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>QUEEN OF HEAVEN</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A"><I>Mary, mother of the King</I></FONT></TD></TR>
      <TR><TD>Elizabeth greets her as<BR/>“the mother of my Lord”</TD></TR>
      <TR><TD><I>“a woman clothed with the sun …<BR/>on her head a crown of twelve stars”</I></TD></TR>
      <TR><TD>assumed into heaven and “exalted<BR/>by the Lord as Queen over all things”</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Lk 1:43  ·  Rev 12:1  ·  CCC 966</FONT></TD></TR>
    </TABLE>>]

    living_ark [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>MARY</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A"><I>the living ark</I></FONT></TD></TR>
      <TR><TD>God makes his dwelling not in a chest<BR/>of wood and gold, but in her womb</TD></TR>
      <TR><TD><I>“the Word became flesh<BR/>and dwelt among us”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A">ἐσκήνωσεν<I>   eskēnōsen, “pitched his tent”</I></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Jn 1:14  ·  Lk 1:31</FONT></TD></TR>
    </TABLE>>]

    mary_carried [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>WHAT MARY CARRIED</B></FONT></TD></TR>
      <TR><TD><B>the Word of God</B><BR/>made flesh</TD></TR>
      <TR><TD><B>the living bread</B><BR/>come down from heaven</TD></TR>
      <TR><TD><B>the eternal high priest</B><BR/>who holds his priesthood for ever</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Jn 1:14  ·  Jn 6:51  ·  Heb 4:14; 7:24</FONT></TD></TR>
    </TABLE>>]

    annunciation [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>THE ANNUNCIATION</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A"><I>over the Virgin</I></FONT></TD></TR>
      <TR><TD><I>“The Holy Spirit will come upon you,<BR/>and the power of the Most High<BR/>will overshadow you”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A">ἐπισκιάσει<I>   episkiasei, “will overshadow”</I></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Lk 1:35</FONT></TD></TR>
    </TABLE>>]

    full_of_grace [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>FULL OF GRACE</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A"><I>immaculate, and assumed into heaven</I></FONT></TD></TR>
      <TR><TD>preserved from every stain<BR/>of sin from her conception</TD></TR>
      <TR><TD>at the end of her earthly life,<BR/>taken body and soul into heavenly glory</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Lk 1:28  ·  CCC 491–492, 966</FONT></TD></TR>
    </TABLE>>]

    ark_in_heaven [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>THE ARK IN HEAVEN</B></FONT></TD></TR>
      <TR><TD><I>“God's temple in heaven was opened,<BR/>and the ark of his covenant<BR/>was seen within his temple …”</I></TD></TR>
      <TR><TD><I>“And a great portent appeared in heaven,<BR/>a woman clothed with the sun”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Rev 11:19 – 12:1</FONT></TD></TR>
    </TABLE>>]

    mary_sets_out [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>MARY SETS OUT</B></FONT></TD></TR>
      <TR><TD><I>“Mary arose and went with haste<BR/>into the hill country,<BR/>to a city of Judah”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Lk 1:39</FONT></TD></TR>
    </TABLE>>]

    elizabeth_asks [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>ELIZABETH ASKS</B></FONT></TD></TR>
      <TR><TD><I>“why is this granted me,<BR/>that the mother of my Lord<BR/>should come to me?”</I></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Lk 1:43</FONT></TD></TR>
    </TABLE>>]

    john_leaps [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>JOHN LEAPS</B></FONT></TD></TR>
      <TR><TD><I>“the babe in my womb<BR/>leaped for joy”</I></TD></TR>
      <TR><TD>Elizabeth “exclaimed with a loud cry”:<BR/>a rare Greek verb that the LXX uses<BR/>for the Levites' music before the ark</TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A">ἀνεφώνησεν<I>   anephōnēsen</I></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Lk 1:41–44  ·  cf. 1 Chr 15:28 (LXX)</FONT></TD></TR>
    </TABLE>>]

    zechariah_house [label=<<TABLE BORDER="0" CELLSPACING="5">
      <TR><TD><FONT POINT-SIZE="34"><B>THREE MONTHS</B></FONT></TD></TR>
      <TR><TD><FONT POINT-SIZE="22" COLOR="#2F5A8A"><I>in the house of Zechariah</I></FONT></TD></TR>
      <TR><TD><I>“Mary remained with her<BR/>about three months”</I></TD></TR>
      <TR><TD>Elizabeth is “filled with the Holy Spirit”:<BR/>“Blessed are you among women”</TD></TR>
      <TR><TD><FONT POINT-SIZE="16">Lk 1:40–42, 56</FONT></TD></TR>
    </TABLE>>]
  }

  // ── Rows, grouped into sections ──────────────────────────────

  { rank=same; hdr_ot; hdr_par; hdr_nt }

  subgraph cluster_beginning {
    label=<<FONT POINT-SIZE="30" COLOR="#6B5236"><B>I · IN THE BEGINNING</B>   <I>the first man and woman</I></FONT>>
    labeljust=l
    style="rounded,dashed"
    color="#CDBB98"
    penwidth=2
    margin=36

    { rank=same; adam;     new_adam; jesus }
    { rank=same; eve;      new_eve;  mary }
    { rank=same; fall;     urging;   cana }
    { rank=same; woman_ot; woman;    woman_nt }
  }

  subgraph cluster_kingdom {
    label=<<FONT POINT-SIZE="30" COLOR="#6B5236"><B>II · THE THRONE OF DAVID</B>   <I>the king and the queen mother</I></FONT>>
    labeljust=l
    style="rounded,dashed"
    color="#CDBB98"
    penwidth=2
    margin=36

    { rank=same; solomon;   king;         christ_king }
    { rank=same; bathsheba; queen_mother; mary_queen }
  }

  subgraph cluster_ark {
    label=<<FONT POINT-SIZE="30" COLOR="#6B5236"><B>III · THE ARK OF THE COVENANT</B>   <I>God's dwelling among his people</I></FONT>>
    labeljust=l
    style="rounded,dashed"
    color="#CDBB98"
    penwidth=2
    margin=36

    { rank=same; ark;         new_ark;       living_ark }
    { rank=same; ark_held;    she_carried;   mary_carried }
    { rank=same; glory_cloud; overshadowed;  annunciation }
    { rank=same; ark_holy;    incorruptible; full_of_grace }
    { rank=same; lost_ark;    ark_revealed;  ark_in_heaven }
  }

  subgraph cluster_visitation {
    label=<<FONT POINT-SIZE="30" COLOR="#6B5236"><B>IV · THE ARK GOES UP TO JUDAH</B>   <I>2 Samuel 6 and the Visitation, Luke 1:39–56</I></FONT>>
    labeljust=l
    style="rounded,dashed"
    color="#CDBB98"
    penwidth=2
    margin=36

    { rank=same; david_sets_out; arose;         mary_sets_out }
    { rank=same; david_asks;     come_to_me;    elizabeth_asks }
    { rank=same; david_dances;   leaping;       john_leaps }
    { rank=same; obed_edom;      house_blessed; zechariah_house }
  }

  // ── Parallels: type —— parallel ——▶ fulfillment ──────────────

  edge [color="#B08A2E" penwidth=5 arrowsize=1.4]

  adam      -> new_adam     [arrowhead=none];  new_adam     -> jesus
  eve       -> new_eve      [arrowhead=none];  new_eve      -> mary
  fall      -> urging       [arrowhead=none];  urging       -> cana
  woman_ot  -> woman        [arrowhead=none];  woman        -> woman_nt
  solomon   -> king         [arrowhead=none];  king         -> christ_king
  bathsheba -> queen_mother [arrowhead=none];  queen_mother -> mary_queen

  ark         -> new_ark       [arrowhead=none];  new_ark       -> living_ark
  ark_held    -> she_carried   [arrowhead=none];  she_carried   -> mary_carried
  glory_cloud -> overshadowed  [arrowhead=none];  overshadowed  -> annunciation
  ark_holy    -> incorruptible [arrowhead=none];  incorruptible -> full_of_grace
  lost_ark    -> ark_revealed  [arrowhead=none];  ark_revealed  -> ark_in_heaven

  david_sets_out -> arose         [arrowhead=none];  arose         -> mary_sets_out
  david_asks     -> come_to_me    [arrowhead=none];  come_to_me    -> elizabeth_asks
  david_dances   -> leaping       [arrowhead=none];  leaping       -> john_leaps
  obed_edom      -> house_blessed [arrowhead=none];  house_blessed -> zechariah_house

  // ── Invisible scaffolding: keeps the three columns straight ──

  edge [style=invis weight=100]

  hdr_ot -> hdr_par -> hdr_nt
  title  -> hdr_par
  hdr_ot  -> adam     -> eve     -> fall   -> woman_ot -> solomon     -> bathsheba
  hdr_par -> new_adam -> new_eve -> urging -> woman    -> king        -> queen_mother
  hdr_nt  -> jesus    -> mary    -> cana   -> woman_nt -> christ_king -> mary_queen

  bathsheba    -> ark        -> ark_held     -> glory_cloud  -> ark_holy      -> lost_ark
  queen_mother -> new_ark    -> she_carried  -> overshadowed -> incorruptible -> ark_revealed
  mary_queen   -> living_ark -> mary_carried -> annunciation -> full_of_grace -> ark_in_heaven

  lost_ark      -> david_sets_out -> david_asks     -> david_dances -> obed_edom
  ark_revealed  -> arose          -> come_to_me     -> leaping      -> house_blessed -> footer
  ark_in_heaven -> mary_sets_out  -> elizabeth_asks -> john_leaps   -> zechariah_house
}
